# ─── Upranko Environment Configuration ─────────────────────────────────────

# Server
PORT=3000
BASE_URL=http://localhost:3000

# ─── Email (choose ONE method) ────────────────────────────────────────────────

# OPTION A: Gmail (easiest)
# 1. Enable 2-Factor Authentication on your Google account
# 2. Go to: myaccount.google.com/apppasswords
# 3. Generate an App Password for "Mail"
# 4. Paste it below (no spaces)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# OPTION B: Custom SMTP (Brevo, Mailgun, Zoho, etc.)
# SMTP_HOST=smtp.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-login
# SMTP_PASS=your-smtp-password

# OPTION C: Brevo (SendinBlue) — recommended for production
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-brevo-login@email.com
# SMTP_PASS=your-brevo-smtp-key
